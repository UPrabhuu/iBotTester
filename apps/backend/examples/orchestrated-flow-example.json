{
  "name": "Complete Agent Flow Example",
  "description": "Demonstrates the full orchestrated agent flow",
  "endpoint": "/api/orchestrated-test",
  "request": {
    "prompt": "Test login with valid credentials on example.com and verify dashboard loads",
    "environment": "staging",
    "runType": "single",
    "options": {
      "headless": true,
      "recordVideo": true,
      "screenshots": true
    }
  },
  "expectedFlow": [
    {
      "agent": "IntentParserAgent",
      "action": "Parse user prompt",
      "output": {
        "action": "login",
        "target": "valid credentials",
        "url": "https://example.com",
        "expectedOutcome": "dashboard loads",
        "confidence": 0.9
      }
    },
    {
      "agent": "TestPlannerAgent",
      "action": "Generate structured test plan",
      "output": {
        "name": "Login and Dashboard Verification Test",
        "steps": [
          {
            "step": 1,
            "action": "navigate",
            "url": "https://example.com"
          },
          {
            "step": 2,
            "action": "click",
            "target": "login button"
          },
          {
            "step": 3,
            "action": "type",
            "target": "username field",
            "value": "testuser"
          },
          {
            "step": 4,
            "action": "type",
            "target": "password field",
            "value": "password123"
          },
          {
            "step": 5,
            "action": "click",
            "target": "submit button"
          },
          {
            "step": 6,
            "action": "validate",
            "rule": "dashboard page loaded"
          }
        ]
      }
    },
    {
      "agent": "ExecutionAgent",
      "action": "Execute test with Playwright",
      "features": [
        "Self-healing selectors",
        "Retry logic (max 2 retries)",
        "Screenshot after each step",
        "Video recording",
        "Console and network logging"
      ]
    },
    {
      "agent": "EvidenceCollectorAgent",
      "action": "Collect execution evidence",
      "collects": [
        "Screenshots (6 total, one per step)",
        "Execution logs with timestamps",
        "Video of entire session",
        "Browser console logs",
        "Network request logs"
      ]
    },
    {
      "agent": "DiffValidationAgent",
      "action": "Compare with previous runs",
      "analyzes": [
        "Page structure changes",
        "Element selector changes",
        "Flow order differences",
        "Self-healing events"
      ],
      "classifies": [
        "Breaking changes (test fails)",
        "Non-breaking changes (self-healing worked)",
        "Cosmetic changes (visual only)"
      ]
    },
    {
      "agent": "ReportGeneratorAgent",
      "action": "Generate comprehensive report",
      "includes": [
        "Human-readable summary",
        "Step-by-step execution status",
        "Failure root cause analysis",
        "Confidence score",
        "Suggested fixes",
        "Change classification",
        "Evidence summary"
      ],
      "personality": "Senior QA Engineer - calm, precise, actionable"
    }
  ],
  "sampleResponse": {
