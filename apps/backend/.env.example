# Backend Environment Variables

# Server Configuration
PORT=3001

# Database Configuration
# For local development with Docker:
DATABASE_URL=postgresql://ibottester:ibottester123@localhost:5432/ibottester
# For production, use your actual PostgreSQL connection string

# JWT Secret for authentication (CHANGE THIS IN PRODUCTION!)
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-use-at-least-32-characters

# OpenAI Configuration (optional - for AI-powered test planning)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
